{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#0052FF",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#0F172A",
          "name": "Secondary"
        }
      ]
    }
  },
  "customTemplates": [
    {
      "name": "page-login",
      "title": "Login Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-register",
      "title": "Register Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-profile",
      "title": "Profile Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-lostpassword",
      "title": "Lost Password Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-password-reset",
      "title": "Password Reset Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-registration-success",
      "title": "Registration Success Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-reset-password-success",
      "title": "Password Reset Success Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-videos",
      "title": "Videos Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-guides",
      "title": "Guides Page",
      "postTypes": ["page"]
    },
    {
      "name": "page-certificates",
      "title": "Certificates Page",
      "postTypes": ["page"]
    }
  ]
}
