{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#111827",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#4b5563",
          "name": "Secondary"
        }
      ]
    }
  }
}
